C Static serial replacement for arrays formerly allocated and pointer-mapped
C by P++.  Names and shapes follow the original ionosphere.F interface.
      REAL X(NIP1,NJP1,NKP1),Y(NIP1,NJP1,NKP1)
      REAL Z(NIP1,NJP1,NKP1)
      REAL BX(NIP1,NJP1,NKP1),BY(NIP1,NJP1,NKP1)
      REAL BZ(NIP1,NJP1,NKP1)
      REAL RHO(NI,NJ,NK),C(NI,NJ,NK)
      REAL EJ_POT(1,NJ,NKP1),EK_POT(1,NJP1,NK)
      REAL VX_POT(1,NJ,NK),VY_POT(1,NJ,NK),VZ_POT(1,NJ,NK)
      REAL RHOION0(NJP1,NKP1),CION0(NJP1,NKP1)
      REAL PSINORTH(NJP1,NK2P3),PSISOUTH(NJP1,NK2P3)
      REAL CURNORTH(NJP1,NK2P3),CURSOUTH(NJP1,NK2P3)
      REAL SIG_P_N(NJP1,NK2P3),SIG_H_N(NJP1,NK2P3)
      REAL SIG_P_S(NJP1,NK2P3),SIG_H_S(NJP1,NK2P3)
      REAL FLUX_N(NJP1,NK2P3),FLUX_S(NJP1,NK2P3)
      REAL AV_ENERGY_N(NJP1,NK2P3),AV_ENERGY_S(NJP1,NK2P3)
      COMMON /LFM_RESCUE_ION_X/ X
      COMMON /LFM_RESCUE_ION_Y/ Y
      COMMON /LFM_RESCUE_ION_Z/ Z
      COMMON /LFM_RESCUE_ION_BX/ BX
      COMMON /LFM_RESCUE_ION_BY/ BY
      COMMON /LFM_RESCUE_ION_BZ/ BZ
      COMMON /LFM_RESCUE_ION_RHO/ RHO
      COMMON /LFM_RESCUE_ION_C/ C
      COMMON /LFM_RESCUE_ION_EJ/ EJ_POT
      COMMON /LFM_RESCUE_ION_EK/ EK_POT
      COMMON /LFM_RESCUE_ION_VX/ VX_POT
      COMMON /LFM_RESCUE_ION_VY/ VY_POT
      COMMON /LFM_RESCUE_ION_VZ/ VZ_POT
      COMMON /LFM_RESCUE_ION_RHO0/ RHOION0
      COMMON /LFM_RESCUE_ION_C0/ CION0
      COMMON /LFM_RESCUE_ION_PN/ PSINORTH
      COMMON /LFM_RESCUE_ION_PS/ PSISOUTH
      COMMON /LFM_RESCUE_ION_CN/ CURNORTH
      COMMON /LFM_RESCUE_ION_CS/ CURSOUTH
      COMMON /LFM_RESCUE_ION_SPN/ SIG_P_N
      COMMON /LFM_RESCUE_ION_SHN/ SIG_H_N
      COMMON /LFM_RESCUE_ION_SPS/ SIG_P_S
      COMMON /LFM_RESCUE_ION_SHS/ SIG_H_S
      COMMON /LFM_RESCUE_ION_FN/ FLUX_N
      COMMON /LFM_RESCUE_ION_FS/ FLUX_S
      COMMON /LFM_RESCUE_ION_AEN/ AV_ENERGY_N
      COMMON /LFM_RESCUE_ION_AES/ AV_ENERGY_S
      SAVE /LFM_RESCUE_ION_X/,/LFM_RESCUE_ION_Y/
      SAVE /LFM_RESCUE_ION_Z/,/LFM_RESCUE_ION_BX/
      SAVE /LFM_RESCUE_ION_BY/,/LFM_RESCUE_ION_BZ/
      SAVE /LFM_RESCUE_ION_RHO/,/LFM_RESCUE_ION_C/
