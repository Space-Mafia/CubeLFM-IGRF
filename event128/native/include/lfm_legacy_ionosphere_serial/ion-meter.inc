C Two-radial-layer axisymmetric metric used by JPARA/JSETUP.
      REAL X2(NIP1,NJP1),Y2(NIP1,NJP1)
      REAL X2C(NI,NJ),Y2C(NI,NJ),VOLQ2(NI,NJ)
      REAL PHI(NKP1),COSPHI(NKP1),SINPHI(NKP1),PHIQ2(NKP1)
      REAL COS2PHI(NK),SIN2PHI(NK),DARC2(NK),COSARC2(NK)
      COMMON /LFM_RESCUE_ION_MERID/ X2,Y2,X2C,Y2C,VOLQ2
      COMMON /LFM_RESCUE_ION_AZIM/ PHI,COSPHI,SINPHI,PHIQ2,
     $ COS2PHI,SIN2PHI,DARC2,COSARC2
      SAVE /LFM_RESCUE_ION_MERID/,/LFM_RESCUE_ION_AZIM/
