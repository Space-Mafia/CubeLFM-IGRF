C Potential, conductance, and potential-gradient storage.
      REAL PSI(NJP1,NK2P3),PSII(NJP1,NK2P1)
      REAL Curnt(NJP1,NK2P3),SIGMAP(NJP1,NK2P3)
      REAL SIGMAH(NJP1,NK2P3),DFLUX(NJP1,NK2P3)
      REAL DENERGY(NJP1,NK2P3)
      REAL PSIETA(NJ,NK2),PSICHI(NJ,NK2)
      REAL VXETA(NJ,NK2),VYETA(NJ,NK2),VZETA(NJ,NK2)
      REAL VXCHI(NJ,NK2),VYCHI(NJ,NK2),VZCHI(NJ,NK2)
      REAL VXINT(NJ,NK2),VYINT(NJ,NK2),VZINT(NJ,NK2)
      COMMON /LFM_RESCUE_ION_POT/ PSI,PSII,CURNT
      COMMON /LFM_RESCUE_ION_COND/ SIGMAP,SIGMAH,DFLUX,DENERGY
      COMMON /LFM_RESCUE_ION_PGRAD/ PSIETA,PSICHI
      COMMON /LFM_RESCUE_ION_VGRAD/ VXETA,VYETA,VZETA,
     $ VXCHI,VYCHI,VZCHI
      COMMON /LFM_RESCUE_ION_VINT/ VXINT,VYINT,VZINT
      SAVE /LFM_RESCUE_ION_POT/,/LFM_RESCUE_ION_COND/
      SAVE /LFM_RESCUE_ION_PGRAD/,/LFM_RESCUE_ION_VGRAD/
      SAVE /LFM_RESCUE_ION_VINT/
