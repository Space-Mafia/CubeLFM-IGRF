C Static ionosphere dimensions for the native 53 x 24 x 32 LFM grid.
C The historical generator used max(NORDER/2-1,2) radial points; NORDER=8.
      INTEGER NI,NJ,NK,NIP1,NJP1,NKP1,NIM1,NJM1,NKM1
      INTEGER NK2,NK4,NK2P1,NK2P2,NK2P3,NKP2,NJP3
      INTEGER NGPTS,NCINT
      PARAMETER (NI=3,NJ=96,NK=128)
      PARAMETER (NIP1=NI+1,NJP1=NJ+1,NKP1=NK+1)
      PARAMETER (NIM1=NI-1,NJM1=NJ-1,NKM1=NK-1)
      PARAMETER (NK2=NK/2,NK4=NK/4)
      PARAMETER (NK2P1=NK2+1,NK2P2=NK2+2,NK2P3=NK2+3)
      PARAMETER (NKP2=NK+2,NJP3=NJ+3)
      PARAMETER (NGPTS=4,NCINT=NK2P3)
