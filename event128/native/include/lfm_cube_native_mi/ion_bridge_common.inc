C Shell-side names for the static COMMON storage used by the reconstructed
C serial ionosphere.  Prefix every local name so this include can coexist
C with the 53 x 24 x 32 MHD PARAM.INC in one program unit.
      INTEGER ION_NI,ION_NJ,ION_NK,ION_NIP1,ION_NJP1,ION_NKP1
      INTEGER ION_NK2,ION_NK2P3
      PARAMETER (ION_NI=3,ION_NJ=96,ION_NK=128)
      PARAMETER (ION_NIP1=ION_NI+1,ION_NJP1=ION_NJ+1,
     $ ION_NKP1=ION_NK+1)
      PARAMETER (ION_NK2=ION_NK/2,ION_NK2P3=ION_NK2+3)

      REAL ION_X(ION_NIP1,ION_NJP1,ION_NKP1)
      REAL ION_Y(ION_NIP1,ION_NJP1,ION_NKP1)
      REAL ION_Z(ION_NIP1,ION_NJP1,ION_NKP1)
      REAL ION_BX(ION_NIP1,ION_NJP1,ION_NKP1)
      REAL ION_BY(ION_NIP1,ION_NJP1,ION_NKP1)
      REAL ION_BZ(ION_NIP1,ION_NJP1,ION_NKP1)
      REAL ION_RHO(ION_NI,ION_NJ,ION_NK)
      REAL ION_CS(ION_NI,ION_NJ,ION_NK)
      REAL ION_EJ(1,ION_NJ,ION_NKP1)
      REAL ION_EK(1,ION_NJP1,ION_NK)
      REAL ION_VX(1,ION_NJ,ION_NK)
      REAL ION_VY(1,ION_NJ,ION_NK)
      REAL ION_VZ(1,ION_NJ,ION_NK)
      REAL ION_PSI_N(ION_NJP1,ION_NK2P3)
      REAL ION_PSI_S(ION_NJP1,ION_NK2P3)
      REAL ION_CUR_N(ION_NJP1,ION_NK2P3)
      REAL ION_CUR_S(ION_NJP1,ION_NK2P3)
      REAL ION_SIGP_N(ION_NJP1,ION_NK2P3)
      REAL ION_SIGH_N(ION_NJP1,ION_NK2P3)
      REAL ION_SIGP_S(ION_NJP1,ION_NK2P3)
      REAL ION_SIGH_S(ION_NJP1,ION_NK2P3)
      REAL ION_CURRENT(ION_NJP1,ION_NKP1)

      COMMON /LFM_RESCUE_ION_X/ ION_X
      COMMON /LFM_RESCUE_ION_Y/ ION_Y
      COMMON /LFM_RESCUE_ION_Z/ ION_Z
      COMMON /LFM_RESCUE_ION_BX/ ION_BX
      COMMON /LFM_RESCUE_ION_BY/ ION_BY
      COMMON /LFM_RESCUE_ION_BZ/ ION_BZ
      COMMON /LFM_RESCUE_ION_RHO/ ION_RHO
      COMMON /LFM_RESCUE_ION_C/ ION_CS
      COMMON /LFM_RESCUE_ION_EJ/ ION_EJ
      COMMON /LFM_RESCUE_ION_EK/ ION_EK
      COMMON /LFM_RESCUE_ION_VX/ ION_VX
      COMMON /LFM_RESCUE_ION_VY/ ION_VY
      COMMON /LFM_RESCUE_ION_VZ/ ION_VZ
      COMMON /LFM_RESCUE_ION_PN/ ION_PSI_N
      COMMON /LFM_RESCUE_ION_PS/ ION_PSI_S
      COMMON /LFM_RESCUE_ION_CN/ ION_CUR_N
      COMMON /LFM_RESCUE_ION_CS/ ION_CUR_S
      COMMON /LFM_RESCUE_ION_SPN/ ION_SIGP_N
      COMMON /LFM_RESCUE_ION_SHN/ ION_SIGH_N
      COMMON /LFM_RESCUE_ION_SPS/ ION_SIGP_S
      COMMON /LFM_RESCUE_ION_SHS/ ION_SIGH_S
      COMMON /LFM_RESCUE_ION_CURRENT/ ION_CURRENT

      LOGICAL ION_PE_BR,ION_TABLE_BR,ION_SM_BR,ION_MODEL_BR
      INTEGER ION_MI_BR,ION_MJ_BR,ION_NI_BR,ION_NJ_BR
      INTEGER ION_ITABLE_BR,ION_ITMAX_BR,ION_LOOPTRIES_BR
      INTEGER ION_ITER_BR,ION_NLOOP_BR
      REAL ION_TILT_BR,ION_TZERO_BR,ION_DELTAT_BR,ION_ZANGLE_BR(1)
      REAL ION_S107_BR,ION_PED0_BR,ION_PEDMIN_BR,ION_HALLMIN_BR
      REAL ION_SIGRATIO_BR,ION_PHARDY_BR,ION_CHARDY_BR,ION_HHARDY_BR
      REAL ION_ERRMAX_BR
      REAL ION_TIME_BR,ION_DT_BR,ION_RIONM_BR
      INTEGER ION_LSTEP_BR
      COMMON /LFM_RESCUE_ION_OWNER_I/ ION_MI_BR,ION_MJ_BR,
     $ ION_NI_BR,ION_NJ_BR
      COMMON /LFM_RESCUE_ION_OWNER_L/ ION_PE_BR
      COMMON /LFM_RESCUE_ION_CTL_L/ ION_TABLE_BR,ION_SM_BR,
     $ ION_MODEL_BR
      COMMON /LFM_RESCUE_ION_CTL_I/ ION_ITABLE_BR,ION_ITMAX_BR,
     $ ION_LOOPTRIES_BR,ION_ITER_BR,ION_NLOOP_BR
      COMMON /LFM_RESCUE_ION_CTL_R/ ION_TILT_BR,ION_TZERO_BR,
     $ ION_DELTAT_BR,ION_ZANGLE_BR,ION_S107_BR,ION_PED0_BR,
     $ ION_PEDMIN_BR,ION_HALLMIN_BR,ION_SIGRATIO_BR,
     $ ION_PHARDY_BR,ION_CHARDY_BR,ION_HHARDY_BR,ION_ERRMAX_BR
      COMMON /LFM_RESCUE_ION_TIME_R/ ION_TIME_BR,ION_DT_BR
      COMMON /LFM_RESCUE_ION_TIME_I/ ION_LSTEP_BR
      COMMON /LFM_RESCUE_ION_CONST/ ION_RIONM_BR

      SAVE /LFM_RESCUE_ION_X/,/LFM_RESCUE_ION_Y/
      SAVE /LFM_RESCUE_ION_Z/,/LFM_RESCUE_ION_BX/
      SAVE /LFM_RESCUE_ION_BY/,/LFM_RESCUE_ION_BZ/
      SAVE /LFM_RESCUE_ION_RHO/,/LFM_RESCUE_ION_C/
      SAVE /LFM_RESCUE_ION_EJ/,/LFM_RESCUE_ION_EK/
      SAVE /LFM_RESCUE_ION_VX/,/LFM_RESCUE_ION_VY/
      SAVE /LFM_RESCUE_ION_VZ/,/LFM_RESCUE_ION_PN/
      SAVE /LFM_RESCUE_ION_PS/,/LFM_RESCUE_ION_CN/
      SAVE /LFM_RESCUE_ION_CS/,/LFM_RESCUE_ION_SPN/
      SAVE /LFM_RESCUE_ION_SHN/,/LFM_RESCUE_ION_SPS/
      SAVE /LFM_RESCUE_ION_SHS/,/LFM_RESCUE_ION_CURRENT/
      SAVE /LFM_RESCUE_ION_OWNER_I/,/LFM_RESCUE_ION_OWNER_L/
      SAVE /LFM_RESCUE_ION_CTL_L/,/LFM_RESCUE_ION_CTL_I/
      SAVE /LFM_RESCUE_ION_CTL_R/,/LFM_RESCUE_ION_TIME_R/
      SAVE /LFM_RESCUE_ION_TIME_I/,/LFM_RESCUE_ION_CONST/
