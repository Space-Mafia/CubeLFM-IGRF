C Ionospheric mapping coordinates retained by CORD/SUBWTS/COEF1.
      REAL X1ION(NJP1,NK2P1),Y1ION(NJP1,NK2P1)
      REAL X2ION(NJP1,NK2P3),Y2ION(NJP1,NK2P3)
      REAL Y2ION_OLD(NJP1,NK2P3)
      REAL XHFION(NJ,NK2),YHFION(NJ,NK2)
      REAL TETA1(NJP1,NK2P1),PHI1(NJP1,NK2P1)
      REAL TETA2(NJP1,NK2P3),PHI2(NJP1,NK2P3)
      REAL TETAHF(NJ,NK2),PHIHF(NJ,NK2)
      REAL ETA1(NJP1,NK2P1),CHI1(NJP1,NK2P1)
      REAL ETAHF(NJ,NK2),CHIHF(NJ,NK2)
      COMMON /LFM_RESCUE_ION_GEO1/ X1ION,Y1ION,X2ION,Y2ION
      COMMON /LFM_RESCUE_ION_GEO2/ Y2ION_OLD,XHFION,YHFION
      COMMON /LFM_RESCUE_ION_ANG1/ TETA1,PHI1,TETA2,PHI2
      COMMON /LFM_RESCUE_ION_ANG2/ TETAHF,PHIHF
      COMMON /LFM_RESCUE_ION_MAP1/ ETA1,CHI1,ETAHF,CHIHF
      SAVE /LFM_RESCUE_ION_GEO1/,/LFM_RESCUE_ION_GEO2/
      SAVE /LFM_RESCUE_ION_ANG1/,/LFM_RESCUE_ION_ANG2/
      SAVE /LFM_RESCUE_ION_MAP1/
